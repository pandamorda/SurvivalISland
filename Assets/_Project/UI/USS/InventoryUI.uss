#root {
    flex-grow: 1;
}

#inventory-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.5);
}

/* Главный контейнер, в котором инвентарь и крафт стоят рядом */
#main-panel {
    position: absolute;

    left: 50%;
    top: 50%;
    translate: -50% -50%;

    flex-direction: row;
    gap: 18px;
}

/* Общее оформление панелей */
#inventory-panel,
#craft-panel {
    background-color: rgba(20, 20, 20, 0.95);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);

    padding: 20px;
}

/* Инвентарь */
#inventory-panel {
    width: 400px;
}

/* Крафт */
#craft-panel {
    width: 460px;
}

.panel-title {
    font-size: 22px;
    color: white;
    unity-font-style: bold;

    margin-bottom: 15px;
}

.small-title {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    unity-font-style: bold;

    margin-bottom: 8px;
}

/* Сетка инвентаря */
.items-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
}

.item-slot {
    width: 70px;
    height: 70px;

    position: relative;

    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;

    border: 1px solid rgba(255, 255, 255, 0.1);
}

.item-icon {
    width: 100%;
    height: 100%;

    -unity-background-scale-mode: scale-to-fit;
}

.item-count {
    position: absolute;
    right: 5px;
    bottom: 3px;

    color: white;
    font-size: 12px;
}

.item-slot:hover {
    border-color: white;
    background-color: rgba(255, 255, 255, 0.15);
}

/* Основная часть крафта */
.craft-content {
    flex-direction: row;
    gap: 20px;

    margin-bottom: 18px;
}

/* Левая часть: ингредиенты */
.craft-left {
    width: 170px;
}

/* Грид 2 на 2 */
.craft-grid {
    width: 150px;

    flex-direction: row;
    flex-wrap: wrap;

    gap: 10px;

    margin-bottom: 12px;
}

.craft-slot {
    width: 70px;
    height: 70px;

    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;

    border: 1px solid rgba(255, 255, 255, 0.12);
}

.craft-slot:hover {
    border-color: rgba(255, 255, 255, 0.8);
    background-color: rgba(255, 255, 255, 0.14);
}

/* Кнопка крафта */
.craft-button {
    width: 150px;
    height: 36px;

    background-color: rgba(255, 180, 70, 0.9);
    color: black;

    border-radius: 8px;
    unity-font-style: bold;
}

.craft-button:hover {
    background-color: rgba(255, 205, 110, 1);
}

/* Правая часть: результат */
.craft-result-block {
    width: 210px;
}

.result-slot {
    width: 90px;
    height: 90px;

    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 10px;

    border: 1px solid rgba(255, 255, 255, 0.15);

    margin-bottom: 8px;
}

.result-name {
    color: white;
    font-size: 14px;
}

/* Блок рецептов */
.recipes-block {
    margin-top: 4px;
}

.recipes-scroll {
    height: 180px;

    background-color: rgba(255, 255, 255, 0.035);
    border-radius: 8px;

    padding: 8px;
}

/* Карточка рецепта */
.recipe-card {
    padding: 10px;

    margin-bottom: 8px;

    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 8px;

    border: 1px solid rgba(255, 255, 255, 0.08);
}

.recipe-card:hover {
    background-color: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.35);
}

.recipe-title {
    color: white;
    font-size: 14px;
    unity-font-style: bold;

    margin-bottom: 4px;
}

.recipe-description {
    color: rgba(255, 255, 255, 0.65);
    font-size: 12px;
}